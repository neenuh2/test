# ---------------------------------------------------------------------------
# Training Program Monitoring System — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# When running via docker-compose, the host is the compose service name `db`.
# For local (non-Docker) development against a local Postgres, use localhost.
DATABASE_URL="postgresql://tpms:tpms_password@localhost:5432/tpms?schema=public"

# --- Auth.js / NextAuth ----------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Base URL of the app (used for callbacks and email links).
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- SMTP / email (Nodemailer) ---------------------------------------------
# Works with BPI Exchange/Outlook relay or any transactional SMTP provider.
# For local testing, point at the MailHog service (docker-compose).
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"          # "true" for TLS on connect (port 465)
SMTP_USER=""                 # leave blank for MailHog
SMTP_PASSWORD=""             # leave blank for MailHog
SMTP_FROM="Training Team <no-reply@bpi.example>"

# --- Application settings (defaults; also editable in-app Settings) --------
APP_TIMEZONE="Asia/Manila"
# Base URL used for the {{submissionLink}} in reminder emails. Falls back to
# AUTH_URL when unset. (No participant portal at launch — points at the app.)
APP_PUBLIC_URL="http://localhost:3000"
# Completion rule defaults (see spec §6.4). Configurable in Settings later.
COMPLETION_ATTENDANCE_THRESHOLD="0.8"
# Reminder offsets in days before due date (comma-separated).
REMINDER_UPCOMING_OFFSETS="3,1"
# Overdue re-notification cadence.
REMINDER_OVERDUE_INTERVAL_DAYS="2"
REMINDER_OVERDUE_MAX_COUNT="3"
# When "true", approved-queue is bypassed and reminders auto-send.
EMAIL_AUTO_SEND="false"

# --- Seed admin (used by prisma/seed.ts) -----------------------------------
SEED_ADMIN_EMAIL="admin@bpi.example"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Training Admin"
