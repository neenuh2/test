// Training Program Monitoring System — Prisma schema
// Full data model per spec §5, plus support tables (Setting, EmailTemplate,
// AuditLog) that later phases require and are cheap to introduce now.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  VIEWER
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RunStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CompletionStatus {
  IN_PROGRESS
  COMPLETED
  DROPPED
}

enum DeliveryMode {
  IN_PERSON
  VIRTUAL
  HYBRID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  LATE
  RESUBMIT
  ACCEPTED
}

enum FeedbackQuestionType {
  RATING_1_5
  RATING_1_10
  TEXT
  MULTIPLE_CHOICE
}

enum NotificationType {
  UPCOMING
  DUE_TODAY
  OVERDUE
}

enum NotificationStatus {
  DRAFT
  APPROVED
  SENT
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Audit back-relations (nullable FKs so a user can be removed without
  // destroying the historical record).
  markedAttendances     Attendance[]      @relation("AttendanceMarkedBy")
  reviewedSubmissions   Submission[]      @relation("SubmissionReviewedBy")
  approvedNotifications NotificationLog[] @relation("NotificationApprovedBy")
  auditLogs             AuditLog[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Cohorts & participants
// ---------------------------------------------------------------------------

model Cohort {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  participants  Participant[]
  moduleCohorts ModuleCohort[]

  @@map("cohorts")
}

model Participant {
  id         String   @id @default(cuid())
  employeeId String   @unique
  firstName  String
  lastName   String
  email      String   @unique
  cohortId   String
  branch     String?
  region     String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cohort            Cohort             @relation(fields: [cohortId], references: [id])
  enrollments       Enrollment[]
  attendances       Attendance[]
  submissions       Submission[]
  feedbackResponses FeedbackResponse[]
  notifications     NotificationLog[]

  @@index([cohortId])
  @@map("participants")
}

// ---------------------------------------------------------------------------
// Programs, modules, curriculum
// ---------------------------------------------------------------------------

model Program {
  id                String        @id @default(cuid())
  code              String        @unique
  name              String
  focus             String?
  targetAudience    String?
  totalTrainingDays Int           @default(0)
  description       String?
  status            ProgramStatus @default(DRAFT)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  modules       Module[]
  runs          ProgramRun[]
  deliverables  Deliverable[]
  feedbackForms FeedbackForm[]

  @@map("programs")
}

model Module {
  id          String  @id @default(cuid())
  programId   String
  title       String
  sequence    Int
  description String?

  program       Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  moduleCohorts ModuleCohort[]
  sessions      Session[]
  deliverables  Deliverable[]
  feedbackForms FeedbackForm[]

  @@index([programId])
  @@index([programId, sequence])
  @@map("modules")
}

// A module with no rows here applies to ALL cohorts in its program.
model ModuleCohort {
  moduleId String
  cohortId String

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@id([moduleId, cohortId])
  @@index([cohortId])
  @@map("module_cohorts")
}

model ProgramRun {
  id        String    @id @default(cuid())
  programId String
  name      String
  startDate DateTime
  endDate   DateTime
  status    RunStatus @default(PLANNED)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  program             Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollments         Enrollment[]
  sessions            Session[]
  deliverableDueDates DeliverableDueDate[]
  submissions         Submission[]
  feedbackResponses   FeedbackResponse[]
  notifications       NotificationLog[]

  @@index([programId])
  @@index([startDate])
  @@map("program_runs")
}

model Enrollment {
  id               String           @id @default(cuid())
  participantId    String
  programRunId     String
  enrolledAt       DateTime         @default(now())
  completionStatus CompletionStatus @default(IN_PROGRESS)
  completedAt      DateTime?

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  programRun  ProgramRun  @relation(fields: [programRunId], references: [id], onDelete: Cascade)

  @@unique([participantId, programRunId])
  @@index([programRunId])
  @@index([participantId])
  @@map("enrollments")
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

model Session {
  id           String       @id @default(cuid())
  programRunId String
  moduleId     String
  sessionDate  DateTime
  startTime    String?
  endTime      String?
  location     String?
  mode         DeliveryMode @default(IN_PERSON)
  trainerName  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  programRun  ProgramRun   @relation(fields: [programRunId], references: [id], onDelete: Cascade)
  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([programRunId])
  @@index([moduleId])
  @@index([sessionDate])
  @@map("sessions")
}

model Attendance {
  id             String           @id @default(cuid())
  sessionId      String
  participantId  String
  status         AttendanceStatus @default(ABSENT)
  markedByUserId String?
  markedAt       DateTime         @default(now())

  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  markedBy    User?       @relation("AttendanceMarkedBy", fields: [markedByUserId], references: [id], onDelete: SetNull)

  @@unique([sessionId, participantId])
  @@index([participantId])
  @@map("attendance")
}

// ---------------------------------------------------------------------------
// Deliverables & submissions
// ---------------------------------------------------------------------------

model Deliverable {
  id            String   @id @default(cuid())
  programId     String
  moduleId      String?
  title         String
  description   String?
  dueOffsetDays Int?
  weight        Float?
  isRequired    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  program       Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  module        Module?              @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  dueDates      DeliverableDueDate[]
  submissions   Submission[]
  notifications NotificationLog[]

  @@index([programId])
  @@index([moduleId])
  @@map("deliverables")
}

model DeliverableDueDate {
  id            String   @id @default(cuid())
  deliverableId String
  programRunId  String
  dueDate       DateTime

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  programRun  ProgramRun  @relation(fields: [programRunId], references: [id], onDelete: Cascade)

  @@unique([deliverableId, programRunId])
  @@index([programRunId])
  @@index([dueDate])
  @@map("deliverable_due_dates")
}

model Submission {
  id               String           @id @default(cuid())
  deliverableId    String
  participantId    String
  programRunId     String
  status           SubmissionStatus @default(NOT_SUBMITTED)
  submittedAt      DateTime?
  reviewedByUserId String?
  reviewedAt       DateTime?
  remarks          String?
  fileUrl          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  programRun  ProgramRun  @relation(fields: [programRunId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("SubmissionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([deliverableId, participantId, programRunId])
  @@index([participantId])
  @@index([programRunId])
  @@index([deliverableId])
  @@map("submissions")
}

// ---------------------------------------------------------------------------
// Feedback
// ---------------------------------------------------------------------------

model FeedbackForm {
  id          String   @id @default(cuid())
  programId   String?
  moduleId    String?
  title       String
  isActive    Boolean  @default(true)
  publicToken String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program   Program?           @relation(fields: [programId], references: [id], onDelete: SetNull)
  module    Module?            @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  questions FeedbackQuestion[]
  responses FeedbackResponse[]

  @@index([programId])
  @@index([moduleId])
  @@map("feedback_forms")
}

model FeedbackQuestion {
  id       String               @id @default(cuid())
  formId   String
  text     String
  type     FeedbackQuestionType
  options  Json?
  sequence Int

  form    FeedbackForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers FeedbackAnswer[]

  @@index([formId])
  @@map("feedback_questions")
}

model FeedbackResponse {
  id            String   @id @default(cuid())
  formId        String
  participantId String?
  programRunId  String?
  submittedAt   DateTime @default(now())

  form        FeedbackForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  participant Participant?     @relation(fields: [participantId], references: [id], onDelete: SetNull)
  programRun  ProgramRun?      @relation(fields: [programRunId], references: [id], onDelete: SetNull)
  answers     FeedbackAnswer[]

  @@index([formId])
  @@index([participantId])
  @@map("feedback_responses")
}

model FeedbackAnswer {
  id          String  @id @default(cuid())
  responseId  String
  questionId  String
  ratingValue Int?
  textValue   String?
  choiceValue String?

  response FeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question FeedbackQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([questionId])
  @@map("feedback_answers")
}

// ---------------------------------------------------------------------------
// Notifications / reminder engine
// ---------------------------------------------------------------------------

model NotificationLog {
  id               String             @id @default(cuid())
  participantId    String
  deliverableId    String
  programRunId     String
  type             NotificationType
  status           NotificationStatus @default(DRAFT)
  scheduledFor     DateTime
  // Day bucket (YYYY-MM-DD in app timezone) used to prevent duplicate sends
  // of the same (participant, deliverable, type) on the same day.
  dedupeDay        String
  sentAt           DateTime?
  approvedByUserId String?
  subject          String
  body             String
  error            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  programRun  ProgramRun  @relation(fields: [programRunId], references: [id], onDelete: Cascade)
  approvedBy  User?       @relation("NotificationApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@unique([participantId, deliverableId, type, dedupeDay])
  @@index([status])
  @@index([scheduledFor])
  @@index([programRunId])
  @@map("notification_logs")
}

// ---------------------------------------------------------------------------
// Support tables (settings, email templates, audit log)
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model EmailTemplate {
  id        String           @id @default(cuid())
  type      NotificationType @unique
  subject   String
  body      String
  updatedAt DateTime         @updatedAt

  @@map("email_templates")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
